{:http    {:port #long #or [#env PORT 3000]
           :host #or [#env HTTP_HOST "0.0.0.0"]}

 :db      {:jdbc-url #or [#env DATABASE_URL "jdbc:sqlite:kigali-keys.db"]
           ;; SQLite is a single-writer store; keep the pool tiny.
           :pool-size #long #or [#env DB_POOL_SIZE 1]}

 :media   {:dir #or [#env MEDIA_DIR "media"]
           :max-upload-bytes 12582912}

 :mail    {;; "outbox" (default) writes every message to sent_emails and never
           ;; transmits — staging stays non-sending. "smtp" actually sends.
           :transport #or [#env MAIL_TRANSPORT "outbox"]
           :smtp {:host     #env SMTP_HOST
                  :port     #long #or [#env SMTP_PORT 465]
                  :user     #env SMTP_USER
                  :pass     #env SMTP_PASS
                  :from     #env SMTP_FROM
                  :reply-to #or [#env SMTP_REPLY_TO nil]
                  :ssl?     #boolean #or [#env SMTP_SSL true]}}

 :secrets {;; HMAC secret for guest booking status links. MUST be overridden in
           ;; every real environment via env var.
           :token-secret #or [#env TOKEN_SECRET "dev-only-insecure-token-secret-change-me"]}

 :session {:cookie-name "kk_session"
           :ttl-hours #long #or [#env SESSION_TTL_HOURS 168]
           :secure? #boolean #or [#env SESSION_COOKIE_SECURE true]}

 :ratelimit {:window-seconds 60
             :max-requests #long #or [#env RATE_LIMIT_MAX 10]}

 :idempotency {:ttl-hours 24}

 :seed    {:photos-dir #or [#env SEED_PHOTOS_DIR "assets/property-photos"]
           :admin-email #or [#env ADMIN_INITIAL_EMAIL "owner@kigalikeys.rw"]
           ;; No default password. Seeding the initial owner is skipped unless
           ;; this env var is set, so no credential is ever hardcoded.
           :admin-password #or [#env ADMIN_INITIAL_PASSWORD nil]
           :admin-name #or [#env ADMIN_INITIAL_NAME "Owner"]}}
