{:paths ["src/backend" "src/backend/resources"]

 :deps
 {org.clojure/clojure            {:mvn/version "1.12.0"}

  ;; config
  aero/aero                      {:mvn/version "1.1.6"}

  ;; lifecycle
  com.stuartsierra/component     {:mvn/version "1.1.0"}

  ;; http
  ring/ring-core                 {:mvn/version "1.13.0"}
  ring/ring-jetty-adapter        {:mvn/version "1.13.0"}
  metosin/reitit                 {:mvn/version "0.7.2"}
  metosin/muuntaja               {:mvn/version "0.6.11"}
  metosin/jsonista               {:mvn/version "0.3.13"}

  ;; validation
  metosin/malli                  {:mvn/version "0.16.4"}

  ;; persistence
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.894"}
  hikari-cp/hikari-cp            {:mvn/version "3.0.1"}
  org.xerial/sqlite-jdbc        {:mvn/version "3.49.1.0"}
  migratus/migratus             {:mvn/version "1.6.7"}

  ;; auth
  buddy/buddy-hashers          {:mvn/version "2.0.167"}
  buddy/buddy-sign             {:mvn/version "3.6.1-359"}

  ;; logging
  org.clojure/tools.logging   {:mvn/version "1.3.0"}
  ch.qos.logback/logback-classic {:mvn/version "1.5.18"}}

 :aliases
 {:run
  {:main-opts ["-m" "kigali.main"]}

  :dev
  {:extra-paths ["dev" "test/backend"]}

  ;; Re-encodes the seed gallery images + approximate-location map into
  ;; src/frontend/public/media/ for the frontend to bundle/deploy to its CDN.
  ;; Same encoder as the backend seeder (kigali.images). See kigali.media-export.
  :export-media
  {:exec-fn   kigali.media-export/export!
   :exec-args {}}

  :test
  {:extra-paths ["test/backend"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/url "https://github.com/cognitect-labs/test-runner"
                  :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}}}
